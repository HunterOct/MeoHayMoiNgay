# Copy to .env and adjust for your environment.

NODE_ENV=development
PORT=3000
# Public origin, no trailing slash. Used for canonical URLs, sitemap and feeds.
SITE_URL=http://localhost:3000

# SQLite database and upload directories (relative to project root or absolute).
DB_PATH=data/blog.db
UPLOAD_DIR=data/uploads

# Set to 1 when behind Cloudflare/nginx/other reverse proxy so client IPs are correct.
TRUST_PROXY=0

# Seed admin account (used only by `npm run seed` / `npm run create-admin`).
ADMIN_EMAIL=admin@meohay.local
ADMIN_PASSWORD=

# Session lifetime (hours). Idle timeout is SESSION_IDLE_HOURS.
SESSION_TTL_HOURS=168
SESSION_IDLE_HOURS=8

# Request limits
MAX_UPLOAD_MB=8
RATE_LIMIT_HTML_PER_MIN=120
RATE_LIMIT_API_PER_MIN=60

# Block known AI-training crawlers in robots.txt and at the edge (search engines stay allowed).
BLOCK_AI_CRAWLERS=1
# Reject obvious automated clients (curl, python-requests, headless browsers) on public pages.
BLOCK_SCRAPER_UAS=1

# Backup retention (days) for `npm run backup`.
BACKUP_RETENTION_DAYS=14

# Override detected timezone for display (default Asia/Ho_Chi_Minh).
SITE_TIMEZONE=Asia/Ho_Chi_Minh
