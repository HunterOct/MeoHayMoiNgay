{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "meohay-m0",
  "main": "src/index.js",
  "compatibility_date": "2026-10-24",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "meohay-m0",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "meohay-m0-media"
    }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "SECURE_OPS", "class_name": "SecureOps" }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["SecureOps"]
    }
  ],
  "triggers": {
    "crons": ["* * * * *"]
  },
  "vars": {
    "MEDIA_PROVIDER": "static",
    "SITE_URL": "http://127.0.0.1:8787"
  },
  "observability": {
    "enabled": true
  }
}
